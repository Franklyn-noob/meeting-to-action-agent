# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# Local runtime state (AgentCore Memory fallback uses this in local mode)
data/
*.db
*.sqlite3

# Local secrets — NEVER commit. The demo loads these at runtime from:
#   ./groq.env   -> GROQ_API_KEY (key name `groq_api`) + smtp_email / smtp_password
#   ./github.env -> GITHUB_TOKEN (dev-only, used to bootstrap the repo)
# Production injects secrets via AWS Secrets Manager / runtime environment.
.env
.env.*
groq.env
github.env
credentials

# AWS AgentCore CLI local runtime state & generated deploy config.
# Regenerated by `agentcore init` / `agentcore deploy`; contain local source
# paths + account/role metadata, so they are intentionally not committed.
.bedrock_agentcore/
.bedrock_agentcore.yaml

# Bundled installers / binary artifacts
*.pkg

# Frontend
frontend/node_modules/
frontend/.vite/
frontend/dist/

# OS / editor
.DS_Store
.vs/
.idea/

# Poolside/harness local config
.poolside/

# Local scratch / working notes (kept locally; not part of the project)
new-note.txt
